# LocalFileStorage's dev-only upload directory (receipts, signatures, ticket attachments) — local
# only, never committed.
Vespera.Api/.vespera-storage/

# Build-time OpenAPI artifact (see Vespera.Api.csproj's GenerateOpenApiDocument target) — regenerated on every build.
Vespera.Api/openapi.json
