{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Vespera": {
    "Database": {
      "Mode": "Auto",
      "Engine": "Postgres",
      "Local": {
        "Host": "localhost",
        "Port": 5432,
        "Database": "vespera_dev",
        "Username": "postgres",
        "Password": "postgres"
      },
      "Docker": {
        "Image": "postgres",
        "Tag": "16-alpine",
        "ContainerName": "vespera-db-dev",
        "VolumeName": "vespera-db-dev-data",
        "Port": 55432,
        "Credentials": {
          "Username": "postgres",
          "Password": "postgres"
        },
        "PullPolicy": "IfNotPresent",
        "ReuseExisting": true,
        "StartupTimeoutSeconds": 60
      },
      "Fallback": {
        "UseSqlite": true
      }
    },
    "BackgroundJobs": {
      "Outbox": {
        "PollIntervalSeconds": 5,
        "BatchSize": 20,
        "MaxAttempts": 5,
        "MaxBackoffSeconds": 300
      },
      "Retention": {
        "RunIntervalHours": 24
      }
    },
    "Jwt": {
      "SigningKey": "dev-only-signing-key-not-for-production-use-32chars+",
      "Issuer": "Vespera",
      "Audience": "Vespera.Client"
    },
    "Storage": {
      "Local": {
        "SigningSecret": "dev-only-signing-secret-not-for-production-use"
      }
    },
    "VirusScan": {
      "Provider": "Null"
    },
    "Ocr": {
      "Provider": "Tesseract",
      "TesseractDataPath": "tessdata",
      "TesseractLanguage": "eng"
    },
    "Cors": {
      "AllowedOrigins": [ "http://localhost:4200" ]
    },
    "CurrencyRates": {
      "USD": { "INR": 83.0 },
      "EUR": { "INR": 90.0 },
      "GBP": { "INR": 105.0 }
    }
  }
}
