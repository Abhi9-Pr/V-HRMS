{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Vespera": {
    "Database": {
      "Mode": "Auto",
      "Engine": "Postgres",
      "Local": {
        "Host": "localhost",
        "Port": 5432,
        "Database": "vespera_dev",
        "Username": "postgres",
        "Password": "postgres"
      },
      "Docker": {
        "Image": "postgres",
        "Tag": "16-alpine",
        "ContainerName": "vespera-db-dev",
        "VolumeName": "vespera-db-dev-data",
        "Port": 55432,
        "Credentials": {
          "Username": "postgres",
          "Password": "postgres"
        },
        "PullPolicy": "IfNotPresent",
        "ReuseExisting": true,
        "StartupTimeoutSeconds": 60
      },
      "Fallback": {
        "UseSqlite": true
      }
    }
  }
}
