<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Swagger reads XML <summary>/<response> docs for the documented-error-shapes requirement.
         CS1591 ("missing XML comment") is suppressed — only the endpoints/DTOs that matter for
         the API surface are annotated, not every internal member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vespera.Application\Vespera.Application.csproj" />
    <ProjectReference Include="..\Vespera.Infrastructure\Vespera.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Observability: Serilog owns structured logs (-> Seq directly); OTel owns traces/metrics
         (-> otel-collector -> Seq via OTLP). See docs/observability.md. -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <!-- Bulk employee import (M7): CSV/Excel parsing lives at this layer, not Application -->
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="ClosedXML" />
    <!-- `dotnet ef` (migrations add/bundle/database update) needs the Design package on whichever
         project is passed as the startup project itself — Vespera.Infrastructure's own reference
         is PrivateAssets="all" so it doesn't flow out to here via the ProjectReference. See
         tools/publish-migrations-bundle.*. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Build-time openapi.json artifact. Swashbuckle's document generator needs to construct the
    real app's DI container, which requires ASPNETCORE_ENVIRONMENT=Testing (the one environment
    guaranteed not to need a real database — see DatabaseServiceCollectionExtensions) and a
    working directory equal to the output directory (where appsettings.Testing.json actually
    lands) — configuration/content-root resolution is otherwise relative to whatever directory
    the build happened to run from. Requires `dotnet tool restore` once (see .config/dotnet-tools.json).
  -->
  <Target Name="GenerateOpenApiDocument" AfterTargets="Build">
    <Exec Command="dotnet swagger tofile --output &quot;$(MSBuildProjectDirectory)\openapi.json&quot; &quot;$(TargetFileName)&quot; v1"
          WorkingDirectory="$(TargetDir)"
          EnvironmentVariables="ASPNETCORE_ENVIRONMENT=Testing"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
