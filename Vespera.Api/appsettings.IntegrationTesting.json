{
  "Vespera": {
    "Database": {
      "Mode": "Auto",
      "Engine": "Postgres",
      "Fallback": {
        "UseSqlite": true
      }
    },
    "Jwt": {
      "SigningKey": "integration-test-signing-key-not-for-production-32chars+",
      "Issuer": "Vespera",
      "Audience": "Vespera.Client"
    },
    "BackgroundJobs": {
      "Outbox": {
        "PollIntervalSeconds": 5,
        "BatchSize": 20,
        "MaxAttempts": 5,
        "MaxBackoffSeconds": 300
      },
      "Retention": {
        "RunIntervalHours": 24
      }
    }
  }
}
