{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Vespera": {
    "Database": {
      "Mode": "External",
      "Engine": "Postgres",
      "External": {
        "ConnectionStringName": "VesperaExternal"
      }
    },
    "Fcm": {
      "ProjectId": "",
      "ClientEmail": "",
      "PrivateKeyPem": ""
    },
    "Apns": {
      "KeyId": "",
      "TeamId": "",
      "BundleId": "",
      "PrivateKeyPem": "",
      "UseSandbox": true
    },
    "MobileMinVersion": {
      "Ios": "1.0.0",
      "Android": "1.0.0"
    }
  }
}
